# Enable Rewrite Engine
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Force HTTPS and NON-WWW for production domain (Single-Hop: www -> non-www, http -> https)
    # Redirect any www request directly to https://paisainminutes.com
    RewriteCond %{HTTP_HOST} ^www\.paisainminutes\.com$ [NC]
    RewriteRule ^ https://paisainminutes.com%{REQUEST_URI} [R=301,L]

    # Force HTTPS for non-www domain (Supports Hostinger / Cloudflare SSL Reverse Proxy)
    RewriteCond %{HTTP_HOST} ^paisainminutes\.com$ [NC]
    RewriteCond %{HTTPS} !on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^ https://paisainminutes.com%{REQUEST_URI} [R=301,L]

    # ------------------------------------------------------------------
    # SECURITY (fix F-4, F-5, F-6, F-7): never serve data, config, logs, docs, env files,
    # developer folders or the old PHP admin API. The live site uses the Node API now.
    # Answered as 404 so the paths do not even confirm they exist. Keep these rules first.
    # ------------------------------------------------------------------
    # dot files (.env, .git, .htpasswd ...) except .well-known
    RewriteRule (^|/)\.(?!well-known(/|$)) - [R=404,L]
    # folders that hold data, config, scripts or old copies of the site
    RewriteRule ^(data|config|includes|scripts|scratch|deploy_update|node_modules)(/|$) - [R=404,L]
    RewriteRule ^admin/(api|data)(/|$) - [R=404,L]
    RewriteRule ^crm/(data|api|src|public|crm_subdomain_update|node_modules)(/|$) - [R=404,L]
    # the old PHP API scripts (admin API, CRM API, public api/*.php)
    RewriteRule ^api/.+\.php$ - [R=404,L]
    # old lead and click writers (removed; replaced by the Node API)
    RewriteRule ^(redirect|submit-lead)\.php$ - [R=404,L]
    RewriteRule ^crm/(redirect|submit-lead|submit_lead)\.php$ - [R=404,L]
    # data, log, document and config files anywhere
    RewriteRule \.(csv|json|log|md|sql|sh|bak|zip|ini|lock|ya?ml|map)$ - [R=404,L]
    RewriteCond %{REQUEST_URI} !^/(robots|ads|humans)\.txt$ [NC]
    RewriteCond %{REQUEST_URI} !^/\.well-known/ [NC]
    RewriteRule \.txt$ - [R=404,L]

    # Ensure DirectoryIndex exclusively prioritizes index.php
    DirectoryIndex index.php

    # 1.5. Redirect direct requests for index.php or index.html to canonical root /
    RewriteCond %{THE_REQUEST} \s/index\.(php|html)[\s?] [NC]
    RewriteRule ^ / [R=301,L]

    # 2. Redirect direct requests for *.php to clean extensionless version (except POST handlers)
    RewriteCond %{REQUEST_METHOD} !POST [NC]
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
    RewriteCond %{REQUEST_URI} !^/index\.php$ [NC]
    RewriteRule ^ /%1 [R=301,L]

    # 3. Redirect trailing slashes externally (SEO friendly)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} ^/(.+)/$
    RewriteRule ^(.*)/$ /%1 [R=301,L,NE]



    # 301 Redirects for Legacy Foreign Template URLs to protect topical authority
    RewriteRule ^about/?$ /about-us [R=301,L]
    RewriteRule ^contact/?$ /contact-us [R=301,L]
    RewriteRule ^services/?$ /personal-loan [R=301,L]
    RewriteRule ^resources/?$ /personal-loan-emi-calculator [R=301,L]
    RewriteRule ^careers/?$ /about-us [R=301,L]
    RewriteRule ^blog/?$ /personal-loan [R=301,L]

    # ==================================================================
    # 301 PERMANENT REDIRECTS FOR RETIRED UNSUPPORTED LOAN PRODUCTS
    # Only Personal Loans up to ₹1,00,000 are supported.
    # Preserve SEO equity by redirecting retired URLs to equivalent Personal Loan hubs.
    # ==================================================================

    # 1. High-Ticket Personal Loan Amount Pages (above ₹1 Lakh limit) -> 1 Lakh Personal Loan
    RewriteRule ^(5|10|20|30|40|50)-lakh-personal-loan(\.php)?$ /1-lakh-personal-loan [R=301,L]

    # ==================================================================
    # HTTP 410 GONE FOR PERMANENTLY RETIRED UNSUPPORTED LOAN PRODUCTS
    # Home Loans, Gold Loans, Auto Loans, Business Loans, LAP, and related calculators
    # are permanently retired. Do not redirect to unrelated Personal Loans (prevents Soft 404s).
    # ==================================================================

    # 1. Home Loans (All amounts, calculators, sub-types)
    RewriteRule ^(home-loan|10-lakh-home-loan|15-lakh-home-loan|20-lakh-home-loan|30-lakh-home-loan|40-lakh-home-loan|50-lakh-home-loan|60-lakh-home-loan|home-construction-loan|home-extension-loan|home-renovation-loan|top-up-home-loan|home-loan-for-women|home-loan-for-self-employed|home-loan-interest-rates|home-loan-low-cibil-score|home-loan-balance-transfer|home-loan-eligibility-calculator|home-loan-emi-calculator|home-loan-prepayment-calculator|plot-loan)(\.php)?$ - [G,L]

    # 2. Gold Loans & Calculators
    RewriteRule ^(gold-loan|gold-loan-emi-calculator)(\.php)?$ - [G,L]

    # 3. Auto / Two-Wheeler / Property / Fixed-Deposit / Agriculture / Education Loans
    RewriteRule ^(car-loan|loan-against-car|two-wheeler-loan|tractor-loan-emi-calculator|loan-against-property|loan-against-property-emi-calculator|dairy-farming-loan|goat-farming-loan|poultry-farm-loan|education-loan|letter-of-credit|loan-against-fixed-deposit)(\.php)?$ - [G,L]

    # 4. Business / Commercial / MSME Loans & Calculators
    RewriteRule ^(business-loan|small-business-loan|startups-loan|msme-loan|mudra-loan|pmegp-loan|working-capital-loan|business-loan-emi-calculator|business-loan-interest-rates|business-loan-low-cibil-score|mudra-loan-emi-calculator|term-loan-emi-calculator)(\.php)?$ - [G,L]

    # ==================================================================
    # RETIRED CREDIT CARD & FOREX CARD PRODUCTS SEO HANDLING
    # Credit cards are permanently discontinued from Paisa in Minutes.
    # Relevant replacement: 301 Permanent Redirect to corresponding hub.
    # No relevant replacement: Return HTTP 410 (Gone) to immediately drop indexation.
    # ==================================================================

    # 1. Relevant 301 Permanent Redirects
    RewriteRule ^cibil-score-for-credit-card(\.php)?$ /cibil-score-for-personal-loan [R=301,L]
    RewriteRule ^loan-on-credit-card(\.php)?$ /personal-loan [R=301,L]

    # 2. HTTP 410 Gone for dedicated Credit Card & Forex Card product/category pages
    RewriteRule ^(credit-card|best-credit-cards|best-forex-cards|compare-credit-cards|credit-card-eligibility|credit-card-lounge-access|rupay-credit-cards|secured-credit-cards|lifetime-free-credit-cards|rewards-credit-cards|cashback-credit-cards|virtual-credit-cards|fuel-credit-cards|travel-credit-cards|international-credit-cards|zero-forex-markup-credit-cards)(\.php)?$ - [G,L]

    # 4. Internally rewrite extensionless requests to the actual .php file if it exists
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^([^\.]+)$ $1.php [NC,L]
</IfModule>

# ----------------------------------------------------------------------
# | Proper W3C Standard MIME Types                                      |
# ----------------------------------------------------------------------
<IfModule mod_mime.c>
    AddType text/javascript                             .js .mjs
    AddType text/css                                    .css
    AddType text/html                                   .html .htm .php
    AddType image/svg+xml                               .svg .svgz
    AddType image/webp                                  .webp
    AddType image/png                                   .png
    AddType image/jpeg                                  .jpeg .jpg
    AddType image/x-icon                                .ico
    AddType font/woff2                                  .woff2
    AddType font/woff                                   .woff
    AddType application/json                            .json

    AddCharset utf-8                                    .js .mjs .css .html .htm .php .json
</IfModule>

<IfModule mod_deflate.c>
    # Compress HTML, CSS, JavaScript, Text, XML and fonts
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
    AddOutputFilterByType DEFLATE application/x-font
    AddOutputFilterByType DEFLATE application/x-font-opentype
    AddOutputFilterByType DEFLATE application/x-font-otf
    AddOutputFilterByType DEFLATE application/x-font-truetype
    AddOutputFilterByType DEFLATE application/x-font-ttf
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE font/opentype
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE image/x-icon
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
</IfModule>

# ----------------------------------------------------------------------
# | Browser Caching (Expires Headers)                                  |
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # CSS & JavaScript
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"

    # Images
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Fonts
    ExpiresByType font/truetype "access plus 1 year"
    ExpiresByType font/opentype "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    # Public HTML/PHP pages - 1 hour edge/browser caching for optimal crawl budget
    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType text/plain "access plus 1 hour"
</IfModule>

# Security Headers & Crawl-Friendly Caching
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Default caching for public HTML/PHP frontend pages
    Header set Cache-Control "public, max-age=3600, stale-while-revalidate=86400"
    Header set Vary "Accept-Encoding"

    # Strict NO-CACHE for Private Admin, CRM, APIs, and Lead Processing Endpoints
    <FilesMatch "^(submit-contact)\.php$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
    <FilesMatch "\.json$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # 1-year immutable caching for static assets
    <FilesMatch "\.(ico|pdf|jpg|jpeg|png|gif|webp|js|css|svg|woff|woff2|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
