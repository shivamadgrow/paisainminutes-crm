# Paisa in Minutes Environment Configuration
# Single Source of Truth Backend API
BACKEND_API_URL=https://api.paisainminutes.tech

CRM_API_URL=https://crm.paisainminutes.com
MAIN_SITE_URL=https://paisainminutes.com

# Meta Conversions API (CAPI) Configuration
# Dataset / Pixel ID
META_PIXEL_ID=1113720467814583

# Meta Graph API System User Access Token (from Meta Events Manager > Settings > Conversions API)
# Store securely in server-side environment. Never expose in frontend code.
META_CAPI_TOKEN=

# Optional: Meta Events Manager Test Event Code (e.g. TEST12345) to verify events in Test Events tool
META_TEST_EVENT_CODE=
